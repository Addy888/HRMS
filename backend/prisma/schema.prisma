// ==========================================
// PAYROLL MANAGEMENT MODULE
// ==========================================

model SalaryTemplate {
  id                    String              @id @default(uuid())
  name                  String              @unique // Junior Developer, Senior Developer, Manager
  code                  String              @unique // JDEV, SDEV, MGR
  
  // Salary Components (Monthly)
  basicSalary           Float               @default(0)
  hra                   Float               @default(0) // House Rent Allowance
  da                    Float               @default(0) // Dearness Allowance
  specialAllowance      Float               @default(0)
  medicalAllowance      Float               @default(0)
  travelAllowance       Float               @default(0)
  foodAllowance         Float               @default(0)
  
  // Variable Components
  performanceBonus      Float               @default(0)
  incentive             Float               @default(0)
  
  // Employer Contributions
  employerPF            Float               @default(0) // Percentage
  employerESI           Float               @default(0) // Percentage
  
  // Employee Deductions
  employeePF            Float               @default(0) // Percentage
  employeeESI           Float               @default(0) // Percentage
  professionalTax       Float               @default(0)
  
  // Calculated Fields
  grossSalary           Float               @default(0) // Sum of all earnings
  totalDeductions       Float               @default(0) // Sum of all deductions
  netSalary             Float               @default(0) // Gross - Deductions
  ctc                   Float               @default(0) // Cost to Company (includes employer contributions)
  
  status                String              @default("ACTIVE") // ACTIVE, INACTIVE
  description           String?             @db.Text
  
  salaryStructures      SalaryStructure[]
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
}

model SalaryStructure {
  id                    String              @id @default(uuid())
  employeeId            String
  employee              Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  templateId            String?
  template              SalaryTemplate?     @relation(fields: [templateId], references: [id], onDelete: SetNull)
  
  // Override template values for specific employee
  basicSalary           Float
  hra                   Float               @default(0)
  da                    Float               @default(0)
  specialAllowance      Float               @default(0)
  medicalAllowance      Float               @default(0)
  travelAllowance       Float               @default(0)
  foodAllowance         Float               @default(0)
  performanceBonus      Float               @default(0)
  incentive             Float               @default(0)
  
  employerPF            Float               @default(0)
  employerESI           Float               @default(0)
  employeePF            Float               @default(0)
  employeeESI           Float               @default(0)
  professionalTax       Float               @default(0)
  
  grossSalary           Float
  totalDeductions       Float
  netSalary             Float
  ctc                   Float
  
  effectiveFrom         DateTime
  effectiveTo           DateTime?
  isActive              Boolean             @default(true)
  
  payrollDetails        PayrollDetail[]
  
  createdBy             String?             // HR User ID
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([employeeId, effectiveFrom])
}

model PayrollCycle {
  id                    String              @id @default(uuid())
  name                  String              @unique // January 2026, Feb 2026
  type                  String              // MONTHLY, BI_WEEKLY, WEEKLY, CUSTOM
  
  month                 Int                 // 1-12
  year                  Int                 // 2026
  
  startDate             DateTime            @db.Date
  endDate               DateTime            @db.Date
  
  paymentDate           DateTime?           @db.Date
  
  status                String              @default("DRAFT") // DRAFT, PROCESSING, COMPLETED, APPROVED, PAID, CANCELLED
  
  totalEmployees        Int                 @default(0)
  totalGross            Float               @default(0)
  totalDeductions       Float               @default(0)
  totalNet              Float               @default(0)
  
  processedBy           String?             // HR User ID
  processedAt           DateTime?
  approvedBy            String?             // Finance User ID
  approvedAt            DateTime?
  
  payrollRuns           PayrollRun[]
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([month, year])
  @@index([month, year])
  @@index([status])
}

model PayrollRun {
  id                    String              @id @default(uuid())
  
  cycleId               String
  cycle                 PayrollCycle        @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  
  employeeId            String
  employee              Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  // Attendance Data (from Attendance Provider)
  totalWorkingDays      Int                 @default(0)
  daysPresent           Float               @default(0) // Includes half days
  daysAbsent            Int                 @default(0)
  daysLate              Int                 @default(0)
  daysHalfDay           Float               @default(0)
  leaveDays             Float               @default(0)
  paidLeaveDays         Float               @default(0)
  unpaidLeaveDays       Float               @default(0)
  holidayDays           Int                 @default(0)
  weekOffDays           Int                 @default(0)
  overtimeHours         Float               @default(0)
  
  // Salary Components (Calculated)
  basicSalary           Float               @default(0)
  hra                   Float               @default(0)
  da                    Float               @default(0)
  specialAllowance      Float               @default(0)
  medicalAllowance      Float               @default(0)
  travelAllowance       Float               @default(0)
  foodAllowance         Float               @default(0)
  performanceBonus      Float               @default(0)
  incentive             Float               @default(0)
  overtimePay           Float               @default(0)
  reimbursement         Float               @default(0)
  
  // Earnings
  totalEarnings         Float               @default(0)
  
  // Deductions
  employeePF            Float               @default(0)
  employeeESI           Float               @default(0)
  professionalTax       Float               @default(0)
  tds                   Float               @default(0)
  loanDeduction         Float               @default(0)
  advanceDeduction      Float               @default(0)
  lateDeduction         Float               @default(0)
  lwpDeduction          Float               @default(0) // Loss of Pay
  otherDeductions       Float               @default(0)
  
  // Total Deductions
  totalDeductions       Float               @default(0)
  
  // Net Salary
  netSalary             Float               @default(0)
  
  // Employer Contributions (not part of net, but tracked)
  employerPF            Float               @default(0)
  employerESI           Float               @default(0)
  
  // Status
  status                String              @default("CALCULATED") // CALCULATED, APPROVED, PAID, HOLD, CANCELLED
  
  // Payment Details
  paymentMode           String?             // BANK_TRANSFER, CASH, CHEQUE
  paymentReference      String?             // Transaction ID
  paidOn                DateTime?
  
  // Metadata
  calculationData       String?             @db.Text // JSON: detailed breakdown
  remarks               String?             @db.Text
  
  payslip               Payslip?
  payrollDetails        PayrollDetail[]
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([cycleId, employeeId])
  @@index([cycleId])
  @@index([employeeId])
  @@index([status])
}

model PayrollDetail {
  id                    String              @id @default(uuid())
  
  payrollRunId          String
  payrollRun            PayrollRun          @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  
  salaryStructureId     String
  salaryStructure       SalaryStructure     @relation(fields: [salaryStructureId], references: [id])
  
  componentType         String              // EARNING, DEDUCTION, EMPLOYER_CONTRIBUTION
  componentName         String              // Basic Salary, HRA, PF, etc.
  amount                Float
  
  calculationMethod     String?             // FIXED, PERCENTAGE, DAYS_BASED, HOURS_BASED
  calculationBase       Float?              // Base amount for percentage calculations
  
  remarks               String?
  
  createdAt             DateTime            @default(now())

  @@index([payrollRunId])
}

model Payslip {
  id                    String              @id @default(uuid())
  
  payrollRunId          String              @unique
  payrollRun            PayrollRun          @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  
  employeeId            String
  employee              Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  month                 Int
  year                  Int
  
  pdfUrl                String?             // Stored PDF file path
  pdfGenerated          Boolean             @default(false)
  
  sentToEmployee        Boolean             @default(false)
  sentAt                DateTime?
  
  viewedByEmployee      Boolean             @default(false)
  viewedAt              DateTime?
  
  downloadCount         Int                 @default(0)
  lastDownloadedAt      DateTime?
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([employeeId, month, year])
  @@index([employeeId])
  @@index([month, year])
}

model Loan {
  id                    String              @id @default(uuid())
  
  employeeId            String
  employee              Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  loanType              String              // PERSONAL, EMERGENCY, ADVANCE, OTHER
  amount                Float               // Total loan amount
  interestRate          Float               @default(0) // Annual percentage
  emiAmount             Float               // Monthly EMI
  tenure                Int                 // Number of months
  
  startDate             DateTime            @db.Date
  endDate               DateTime            @db.Date
  
  totalPaid             Float               @default(0)
  balance               Float               // Remaining amount
  
  status                String              @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED, DEFAULTED
  
  approvedBy            String?             // HR/Finance User ID
  approvedAt            DateTime?
  
  remarks               String?             @db.Text
  
  repayments            LoanRepayment[]
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([employeeId])
  @@index([status])
}

model LoanRepayment {
  id                    String              @id @default(uuid())
  
  loanId                String
  loan                  Loan                @relation(fields: [loanId], references: [id], onDelete: Cascade)
  
  payrollRunId          String?             // Link to payroll if deducted from salary
  
  amount                Float
  principalAmount       Float
  interestAmount        Float
  
  paymentDate           DateTime            @db.Date
  paymentMode           String              // SALARY_DEDUCTION, MANUAL_PAYMENT
  
  remarks               String?
  
  createdAt             DateTime            @default(now())

  @@index([loanId])
}

model AdvanceSalary {
  id                    String              @id @default(uuid())
  
  employeeId            String
  employee              Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  amount                Float
  reason                String              @db.Text
  
  requestDate           DateTime            @default(now())
  
  status                String              @default("PENDING") // PENDING, APPROVED, REJECTED, PAID, RECOVERED
  
  approvedBy            String?
  approvedAt            DateTime?
  rejectionReason       String?             @db.Text
  
  paidOn                DateTime?
  recoveryStartMonth    Int?                // Month from which to start deduction
  recoveryStartYear     Int?
  recoveryMonths        Int?                // Number of months for recovery
  recoveredAmount       Float               @default(0)
  
  remarks               String?             @db.Text
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([employeeId])
  @@index([status])
}

model PayrollAuditLog {
  id                    String              @id @default(uuid())
  
  cycleId               String?
  employeeId            String?
  payrollRunId          String?
  
  action                String              // CYCLE_CREATED, SALARY_CALCULATED, PAYROLL_APPROVED, PAYMENT_PROCESSED, etc.
  performedBy           String              // User ID
  
  oldData               String?             @db.Text // JSON
  newData               String?             @db.Text // JSON
  
  ipAddress             String?
  userAgent             String?
  
  remarks               String?             @db.Text
  
  createdAt             DateTime            @default(now())

  @@index([cycleId])
  @@index([employeeId])
  @@index([performedBy])
  @@index([createdAt])
}

model PayrollSettings {
  id                    String              @id @default(uuid())
  
  key                   String              @unique // PF_RATE, ESI_RATE, PT_RATE, etc.
  value                 String              @db.Text
  dataType              String              // NUMBER, BOOLEAN, STRING, JSON
  
  description           String?             @db.Text
  category              String?             // TAX, DEDUCTION, GENERAL
  
  updatedBy             String?
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
}


// ==========================================
// SETTINGS & SYSTEM ADMINISTRATION - PHASE 15
// ==========================================

// System Settings (Key-Value Configuration)
model SystemSetting {
  id                    String              @id @default(uuid())
  category              String              // SYSTEM, AUTHENTICATION, SECURITY, EMAIL, SMS, STORAGE, NOTIFICATION, etc.
  key                   String              // Unique setting key
  value                 String              @db.Text // JSON or string value
  dataType              String              // STRING, NUMBER, BOOLEAN, JSON, ARRAY
  
  description           String?             @db.Text
  isEncrypted           Boolean             @default(false)
  isPublic              Boolean             @default(false) // Can be accessed without auth
  
  updatedBy             String?             // User ID who last updated
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([category, key])
  @@index([category])
  @@index([key])
}

// Company Profile & Settings
model Company {
  id                    String              @id @default(uuid())
  
  // Basic Information
  name                  String
  legalName             String?
  logoUrl               String?
  faviconUrl            String?
  
  // Address
  address               String?             @db.Text
  city                  String?
  state                 String?
  country               String?
  zipCode               String?
  
  // Legal Information
  gstNumber             String?
  panNumber             String?
  cinNumber             String?             // Corporate Identification Number
  tanNumber             String?             // Tax Deduction Account Number
  
  // Contact Information
  website               String?
  supportEmail          String?
  supportPhone          String?
  hrEmail               String?
  financeEmail          String?
  
  // Localization
  timeZone              String              @default("Asia/Kolkata")
  currency              String              @default("INR")
  currencySymbol        String              @default("₹")
  language              String              @default("en")
  dateFormat            String              @default("DD/MM/YYYY")
  timeFormat            String              @default("12") // 12 or 24
  
  // Work Settings
  workWeekStart         String              @default("MONDAY") // MONDAY, SUNDAY
  fiscalYearStart       Int                 @default(4) // Month number (4 = April)
  
  // Status
  isActive              Boolean             @default(true)
  
  branches              Branch[]
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
}

// Branch/Location Management
model Branch {
  id                    String              @id @default(uuid())
  companyId             String
  company               Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  code                  String              @unique // BLR, MUM, DEL
  name                  String              // Bangalore HQ, Mumbai Office
  
  branchType            String              @default("OFFICE") // OFFICE, FACTORY, WAREHOUSE, REMOTE
  
  // Address
  address               String?             @db.Text
  city                  String?
  state                  String?
  country               String?
  zipCode               String?
  
  // Contact
  phone                 String?
  email                 String?
  managerName           String?
  managerEmail          String?
  
  // Geolocation
  latitude              Float?
  longitude             Float?
  geoFenceRadius        Int?                // in meters (for attendance)
  
  // Work Settings Override
  timeZone              String?             // Override company timezone
  workingHours          String?             @db.Text // JSON: {start, end}
  
  isActive              Boolean             @default(true)
  isHeadquarters        Boolean             @default(false)
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([companyId])
  @@index([code])
}

// Permission Definitions
model Permission {
  id                    String              @id @default(uuid())
  
  module                String              // EMPLOYEES, ATTENDANCE, PAYROLL, PERFORMANCE, SETTINGS, etc.
  resource              String              // USER, DOCUMENT, COMPLAINT, GOAL, etc.
  action                String              // CREATE, READ, UPDATE, DELETE, APPROVE, EXPORT, etc.
  
  code                  String              @unique // employees:user:create, attendance:view:read
  name                  String              // Create Employee, View Attendance
  description           String?             @db.Text
  
  category              String?             // UI, API, BUTTON, FIELD
  
  isSystemPermission    Boolean             @default(false) // Cannot be deleted
  
  rolePermissions       RolePermission[]
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([module])
  @@index([resource])
  @@index([code])
}

// Role-Permission Mapping
model RolePermission {
  id                    String              @id @default(uuid())
  
  roleId                String
  role                  Role                @relation(fields: [roleId], references: [id], onDelete: Cascade)
  
  permissionId          String
  permission            Permission          @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  
  granted               Boolean             @default(true) // true = allow, false = deny (explicit deny)
  
  createdAt             DateTime            @default(now())

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

// Email Templates
model EmailTemplate {
  id                    String              @id @default(uuid())
  
  name                  String              @unique // WELCOME_EMAIL, PASSWORD_RESET, PAYSLIP_GENERATED
  subject               String
  body                  String              @db.Text // HTML template with placeholders
  
  category              String              // AUTHENTICATION, EMPLOYEE, PAYROLL, PERFORMANCE, NOTIFICATION
  
  variables             String?             @db.Text // JSON: [{name, description, required}]
  
  isActive              Boolean             @default(true)
  isSystem              Boolean             @default(false) // System templates cannot be deleted
  
  createdBy             String?
  updatedBy             String?
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([category])
  @@index([name])
}

// SMS Templates
model SMSTemplate {
  id                    String              @id @default(uuid())
  
  name                  String              @unique // OTP_SMS, LEAVE_APPROVED, ATTENDANCE_ALERT
  message               String              @db.Text // SMS text with placeholders
  
  category              String              // AUTHENTICATION, EMPLOYEE, ATTENDANCE, ALERT
  
