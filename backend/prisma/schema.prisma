// Integration Configurations
model IntegrationConfig {
  id                    String              @id @default(uuid())
  
  provider              String              @unique // SMTP, AWS_S3, TWILIO, SENDGRID, etc.
  providerType          String              // EMAIL, SMS, STORAGE, WHATSAPP, PAYMENT, etc.
  
