  buttons               String?             @db.Text // JSON: [{type, text, url}]
  
  variables             String?             @db.Text // JSON: [{name, description}]
  
  metaTemplateId        String?             // Meta/WhatsApp Business Template ID
  status                String              @default("DRAFT") // DRAFT, PENDING_APPROVAL, APPROVED, REJECTED
  
