// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // HR, EMPLOYEE
  description String?
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id                 String           @id @default(uuid())
  email              String           @unique
  password           String
  roleId             String
  role               Role             @relation(fields: [roleId], references: [id])
  isFirstLogin       Boolean          @default(true)
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  employee           Employee?
  passwordResets     PasswordReset[]
  auditLogs          AuditLog[]
  notifications      Notification[]
  complaintsRaised   Complaint[]      @relation("ComplaintsRaised")
  complaintReplies   ComplaintReply[]
}

model Department {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  employees   Employee[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Designation {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  employees   Employee[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Employee {
  id            String             @id @default(uuid())
  employeeId    String             @unique // Custom format e.g. FCS-YYYY-XXXX
  userId        String             @unique
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName     String
  lastName      String
  phone         String?
  dob           DateTime?
  gender        String?
  bloodGroup    String?
  address       String? // Deprecated in favor of currentAddress/permanentAddress
  
  // Personal Info
  fatherName    String?
  motherName    String?
  maritalStatus String?
  nationality   String?

  // Contact Info
  alternatePhone String?
  personalEmail  String?
  permanentAddress String?
  currentAddress   String?
  emergencyContactName String?
  emergencyContactPhone String?
  emergencyContactRelation String?
  emergencyContact String? // Deprecated in favor of emergencyContactName/Phone/Relation

  // Professional Info
  reportingManager String?
  employmentType   String? // e.g. FULL_TIME, PART_TIME, CONTRACT, INTERN

  // Bank Details
  bankAccountHolder String?
  bankName          String?
  bankBranch        String?
  bankAccountNumber String?
  bankIfsc          String?
  upiId             String?

  // Government Details
  aadhaarNumber       String?
  panNumber           String?
  passportNumber      String?
  drivingLicenseNumber String?

  joiningDate   DateTime           @default(now())
  departmentId  String?
  department    Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designationId String?
  designation   Designation?       @relation(fields: [designationId], references: [id], onDelete: SetNull)
  photoUrl      String?
  onboardingStatus String          @default("PENDING") // PENDING, PROFILE_COMPLETED, DOCUMENTS_UPLOADED, POLICIES_ACCEPTED, COMPLETED, VERIFIED
  
  profile       EmployeeProfile?
  education     Education[]
  experience    Experience[]
  documents     Document[]
  acknowledgement Acknowledgement?
  acceptances   PolicyAcceptance[]

  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model EmployeeProfile {
  id                String   @id @default(uuid())
  employeeId        String   @unique
  employee          Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  profileCompletion Int      @default(0) // Percentage completion
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Education {
  id           String   @id @default(uuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  degree       String   // 10th, 12th, Graduation, PG, etc.
  institution  String
  passingYear  Int
  percentage   Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Experience {
  id           String    @id @default(uuid())
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  companyName  String
  designation  String
  startDate    DateTime
  endDate      DateTime?
  description  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model DocumentCategory {
  id        String     @id @default(uuid())
  name      String     @unique // PERSONAL, EDUCATIONAL, PROFESSIONAL, GOVERNMENT, OTHER
  documents Document[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Document {
  id           String                 @id @default(uuid())
  employeeId   String
  employee     Employee               @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type         String                 // RESUME, PHOTO, AADHAAR, PAN, PASSPORT, marksheet_10th, marksheet_12th, graduation_degree, etc.
  fileUrl      String
  fileName     String
  status       String                 @default("PENDING") // PENDING, APPROVED, REJECTED, RE_UPLOAD_REQUIRED
  categoryId   String?
  category     DocumentCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  verification DocumentVerification?
  versions     DocumentVersion[]
  auditLogs    DocumentAuditLog[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
}

model DocumentVersion {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  fileUrl    String
  fileName   String
  version    Int      @default(1)
  uploadedAt DateTime @default(now())
}

model DocumentAuditLog {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId     String
  action     String   // UPLOAD, DELETE, REPLACE, APPROVE, REJECT, DOWNLOAD, PREVIEW
  details    String?  @db.Text
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
}

model DocumentVerification {
  id         String   @id @default(uuid())
  documentId String   @unique
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  verifiedBy String?  // HR User Id or Name
  comment    String?
  verifiedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Policy {
  id           String             @id @default(uuid())
  title        String             @unique
  policyNumber String             @unique
  category     String             // ATTENDANCE, LEAVE, CODE_OF_CONDUCT, POSH, DATA_PRIVACY, INFO_SEC, IT_USAGE, NDA, HANDBOOK, etc.
  description  String?            @db.Text
  content      String             @db.Text // Rich Text editor content
  version      Int                @default(1)
  status       String             @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  effectiveDate DateTime?
  expiryDate   DateTime?
  createdBy    String?            // HR User ID or Name
  updatedBy    String?            // HR User ID or Name
  
  assignments  PolicyAssignment[]
  acceptances  PolicyAcceptance[]
  versions     PolicyVersion[]
  auditLogs    PolicyAuditLog[]

  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model PolicyVersion {
  id            String    @id @default(uuid())
  policyId      String
  policy        Policy    @relation(fields: [policyId], references: [id], onDelete: Cascade)
  title         String
  content       String    @db.Text
  versionNumber Int
  effectiveDate DateTime?
  createdAt     DateTime  @default(now())
}

model PolicyAssignment {
  id         String   @id @default(uuid())
  policyId   String
  policy     Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  targetType String   // ALL, DEPARTMENT, DESIGNATION, EMPLOYEE
  targetId   String?  // Dept ID, Desg ID, or Employee ID (null if ALL)
  createdAt  DateTime @default(now())
}

model PolicyAcceptance {
  id              String   @id @default(uuid())
  policyId        String
  policy          Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  versionAccepted Int      @default(1)
  acceptedAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([policyId, employeeId])
}

model Acknowledgement {
  id         String   @id @default(uuid())
  employeeId String   @unique
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  fullName   String
  ipAddress  String
  userAgent  String
  signedAt   DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model PolicyAuditLog {
  id         String   @id @default(uuid())
  policyId   String
  policy     Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  userId     String
  action     String   // CREATE, UPDATE, DELETE, PUBLISH, ARCHIVE, ASSIGN, ACCEPT
  details    String?  @db.Text
  createdAt  DateTime @default(now())
}

model Complaint {
  id          String           @id @default(uuid())
  title       String
  description String           @db.Text
  category    String           // HARASSMENT, FACILITY, IT, PAYROLL, GENERAL, etc.
  priority    String           // LOW, MEDIUM, HIGH, URGENT
  attachmentUrl String?
  status      String           @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  raisedById  String
  raisedBy    User             @relation("ComplaintsRaised", fields: [raisedById], references: [id], onDelete: Cascade)
  assignedTo  String?          // HR User ID
  replies     ComplaintReply[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model ComplaintReply {
  id          String    @id @default(uuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  message     String    @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  message     String
  type        String   // DOCUMENT_APPROVED, DOCUMENT_REJECTED, COMPLAINT_UPDATED, POLICY_UPDATED, PASSWORD_CHANGED, PROFILE_APPROVED, GENERAL
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String   // e.g. LOGIN, UPDATE_PROFILE, APPROVE_DOCUMENT, RAISE_COMPLAINT, etc.
  details    String   @db.Text
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
