  dltTemplateId         String?             // DLT Template ID for India
  
  isActive              Boolean             @default(true)
  isSystem              Boolean             @default(false)
  
  createdBy             String?
  updatedBy             String?
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([category])
  @@index([name])
}

// WhatsApp Templates
model WhatsAppTemplate {
  id                    String              @id @default(uuid())
  
  name                  String              @unique // WELCOME_WHATSAPP, PAYSLIP_READY
  message               String              @db.Text
  
  category              String              // EMPLOYEE, PAYROLL, NOTIFICATION
  
  headerType            String?             // TEXT, IMAGE, VIDEO, DOCUMENT
  headerContent         String?             @db.Text
  
