// Security Settings
model SecuritySetting {
  id                    String              @id @default(uuid())
  
  // Password Policy
  passwordMinLength     Int                 @default(8)
  passwordRequireUppercase Boolean          @default(true)
  passwordRequireLowercase Boolean          @default(true)
  passwordRequireNumbers Boolean            @default(true)
  passwordRequireSpecialChars Boolean       @default(false)
  passwordExpiryDays    Int?                // null = no expiry
  passwordHistoryCount  Int                 @default(3) // Remember last N passwords
  
  // Login Security
  maxLoginAttempts      Int                 @default(5)
  lockoutDuration       Int                 @default(30) // minutes
  
  // Session Management
  sessionTimeout        Int                 @default(30) // minutes of inactivity
  maxActiveSessions     Int                 @default(3)
  autoLogout            Boolean             @default(true)
  
  // Two Factor Authentication
  twoFactorEnabled      Boolean             @default(false)
  twoFactorMethod       String?             // SMS, EMAIL, AUTHENTICATOR_APP
  
  // JWT Settings
  jwtAccessTokenExpiry  Int                 @default(15) // minutes
  jwtRefreshTokenExpiry Int                 @default(7) // days
  
  // IP Restrictions
  ipWhitelist           String?             @db.Text // JSON: array of IPs
  ipBlacklist           String?             @db.Text // JSON: array of IPs
  
  // API Security
  apiRateLimitPerMinute Int                 @default(60)
  apiRateLimitPerHour   Int                 @default(1000)
  
  // CORS Settings
  corsEnabled           Boolean             @default(true)
  corsOrigins           String              @db.Text // JSON: array of allowed origins
  
  // Encryption
  dataEncryptionEnabled Boolean             @default(true)
  encryptionAlgorithm   String              @default("AES-256-GCM")
  
  updatedBy             String?
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
}

// Application Logs
model ApplicationLog {
  id                    String              @id @default(uuid())
  
  level                 String              // DEBUG, INFO, WARN, ERROR, FATAL
  category              String              // APPLICATION, DATABASE, API, SECURITY, PERFORMANCE
  
  message               String              @db.Text
  stackTrace            String?             @db.Text
  
  userId                String?
  requestId             String?
  
  module                String?             // Module/controller name
  method                String?             // Method/function name
  
  metadata              String?             @db.Text // JSON: additional context
  
  ipAddress             String?
  userAgent             String?
  
  createdAt             DateTime            @default(now())

  @@index([level])
  @@index([category])
  @@index([userId])
  @@index([createdAt])
}

// API Request Logs
model APILog {
  id                    String              @id @default(uuid())
  
  requestId             String              @unique
  
  userId                String?
  
  method                String              // GET, POST, PUT, DELETE, PATCH
  endpoint              String              // /api/employees
  
  requestHeaders        String?             @db.Text // JSON
  requestBody           String?             @db.Text // JSON (sanitized, no sensitive data)
  requestQuery          String?             @db.Text // JSON
  
  responseStatus        Int                 // 200, 404, 500, etc.
  responseBody          String?             @db.Text // JSON (truncated if large)
  
  duration              Int                 // milliseconds
  
  ipAddress             String?
  userAgent             String?
  
  error                 String?             @db.Text
  
  createdAt             DateTime            @default(now())

  @@index([userId])
  @@index([endpoint])
  @@index([responseStatus])
  @@index([createdAt])
}

// Backup History
model BackupHistory {
  id                    String              @id @default(uuid())
  
  type                  String              // DATABASE, FILES, FULL
  
  backupName            String              @unique // backup_2026_02_05_120000
  
  size                  Float?              // Size in MB
  filePath              String?             // Local/cloud path
  storageProvider       String?             // LOCAL, S3, AZURE, GCS
  
  status                String              // INITIATED, IN_PROGRESS, COMPLETED, FAILED, VERIFIED
  
  startedAt             DateTime            @default(now())
  completedAt           DateTime?
  
  duration              Int?                // seconds
  
  error                 String?             @db.Text
  
  // Backup Details
  tablesIncluded        String?             @db.Text // JSON: array of table names
  recordCount           Int?
  
  // Restore Information
  canRestore            Boolean             @default(true)
  restoredCount         Int                 @default(0)
  lastRestoredAt        DateTime?
  
  // Verification
  verified              Boolean             @default(false)
  verifiedAt            DateTime?
  checksum              String?
  
  // Retention
  expiresAt             DateTime?
  autoDeleteAfterExpiry Boolean             @default(false)
  
  triggeredBy           String?             // User ID or "SYSTEM"
  isAutomatic           Boolean             @default(false)
  
  metadata              String?             @db.Text // JSON: additional info
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([type])
  @@index([status])
  @@index([startedAt])
}

// System Health Metrics
model SystemMetric {
  id                    String              @id @default(uuid())
  
  metricType            String              // CPU_USAGE, MEMORY_USAGE, DISK_USAGE, DATABASE_CONNECTIONS, API_RESPONSE_TIME
  
  value                 Float
  unit                  String              // PERCENTAGE, MB, MS, COUNT
  
  threshold             Float?              // Alert threshold
  isAlert               Boolean             @default(false)
  
  metadata              String?             @db.Text // JSON
  
  recordedAt            DateTime            @default(now())

  @@index([metricType])
  @@index([recordedAt])
}

// Feature Flags
model FeatureFlag {
  id                    String              @id @default(uuid())
  
  name                  String              @unique // ENABLE_PERFORMANCE_MODULE, ENABLE_AI_FEATURES
  description           String?             @db.Text
  
  isEnabled             Boolean             @default(false)
  
  rolloutPercentage     Int                 @default(100) // 0-100
  
  targetRoles           String?             @db.Text // JSON: array of role IDs
  targetUsers           String?             @db.Text // JSON: array of user IDs
  
  startDate             DateTime?
  endDate               DateTime?
  
  metadata              String?             @db.Text // JSON
  
  createdBy             String?
  updatedBy             String?
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([name])
  @@index([isEnabled])
}
