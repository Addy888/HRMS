// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Role {
  id              String           @id @default(uuid())
  name            String           @unique // SUPER_ADMIN, HR, MANAGER, EMPLOYEE
  displayName     String?          // Display name for UI
  description     String?
  level           Int              @default(0) // For role hierarchy (0=lowest, 100=highest)
  isSystem        Boolean          @default(false) // System roles cannot be deleted
  isActive        Boolean          @default(true)
  users           User[]
  rolePermissions RolePermission[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model User {
  id                 String           @id @default(uuid())
  email              String           @unique
  password           String
  roleId             String
  role               Role             @relation(fields: [roleId], references: [id])
  isFirstLogin       Boolean          @default(true)
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  employee           Employee?
  passwordResets     PasswordReset[]
  auditLogs          AuditLog[]
  notifications           Notification[]          @relation("UserNotifications")
  notificationRecipients  NotificationRecipient[] @relation("UserNotificationRecipients")
  announcementsCreated    Announcement[]          @relation("UserAnnouncementsCreated")
  announcementRecipients  AnnouncementRecipient[] @relation("UserAnnouncementRecipients")
  notificationPreference  NotificationPreference?
  complaintReplies   ComplaintReply[]
  complaintTimelineEvents ComplaintTimeline[]
  complaintAuditLogs ComplaintAuditLog[]
}

model Department {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  employees   Employee[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Designation {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  employees   Employee[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Employee {
  id            String             @id @default(uuid())
  employeeId    String             @unique // Custom format e.g. FCS-YYYY-XXXX
  userId        String             @unique
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName     String
  lastName      String
  phone         String?
  dob           DateTime?
  gender        String?
  bloodGroup    String?
  address       String? // Deprecated in favor of currentAddress/permanentAddress
  
  // Personal Info
  fatherName    String?
  motherName    String?
  maritalStatus String?
  nationality   String?

  // Contact Info
  alternatePhone String?
  personalEmail  String?
  permanentAddress String?
  currentAddress   String?
  emergencyContactName String?
  emergencyContactPhone String?
  emergencyContactRelation String?
  emergencyContact String? // Deprecated in favor of emergencyContactName/Phone/Relation

  // Professional Info
  reportingManager String?
  employmentType   String? // e.g. FULL_TIME, PART_TIME, CONTRACT, INTERN

  // Bank Details
  bankAccountHolder String?
  bankName          String?
  bankBranch        String?
  bankAccountNumber String?
  bankIfsc          String?
  upiId             String?

  // Government Details
  aadhaarNumber       String?
  panNumber           String?
  passportNumber      String?
  drivingLicenseNumber String?

  joiningDate   DateTime           @default(now())
  departmentId  String?
  department    Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designationId String?
  designation   Designation?       @relation(fields: [designationId], references: [id], onDelete: SetNull)
  photoUrl      String?
  onboardingStatus String          @default("PENDING") // PENDING, PROFILE_COMPLETED, DOCUMENTS_UPLOADED, POLICIES_ACCEPTED, COMPLETED, VERIFIED
  
  profile       EmployeeProfile?
  education     Education[]
  experience    Experience[]
  documents     Document[]
  acknowledgement Acknowledgement?
  acceptances   PolicyAcceptance[]
  complaintsRaised Complaint[] @relation("EmployeeComplaintsRaised")
  complaintsAssigned Complaint[] @relation("HRComplaintsAssigned")
  complaintAssignmentsHistory ComplaintAssignment[] @relation("HRComplaintsAssignmentHistory")
  complaintAssignmentsBy ComplaintAssignment[] @relation("HRComplaintsAssignedBy")
  
  // Attendance Relations
  attendances      Attendance[]
  shiftAssignments ShiftAssignment[]
  
  // Payroll Relations
  salaryStructures SalaryStructure[]
  payrollRuns      PayrollRun[]
  payslips         Payslip[]
  loans            Loan[]
  advanceSalaries  AdvanceSalary[]

  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model EmployeeProfile {
  id                String   @id @default(uuid())
  employeeId        String   @unique
  employee          Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  profileCompletion Int      @default(0) // Percentage completion
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Education {
  id           String   @id @default(uuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  degree       String   // 10th, 12th, Graduation, PG, etc.
  institution  String
  passingYear  Int
  percentage   Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Experience {
  id           String    @id @default(uuid())
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  companyName  String
  designation  String
  startDate    DateTime
  endDate      DateTime?
  description  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model DocumentCategory {
  id        String     @id @default(uuid())
  name      String     @unique // PERSONAL, EDUCATIONAL, PROFESSIONAL, GOVERNMENT, OTHER
  documents Document[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Document {
  id           String                 @id @default(uuid())
  employeeId   String
  employee     Employee               @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type         String                 // RESUME, PHOTO, AADHAAR, PAN, PASSPORT, marksheet_10th, marksheet_12th, graduation_degree, etc.
  fileUrl      String
  fileName     String
  status       String                 @default("PENDING") // PENDING, APPROVED, REJECTED, RE_UPLOAD_REQUIRED
  categoryId   String?
  category     DocumentCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  verification DocumentVerification?
  versions     DocumentVersion[]
  auditLogs    DocumentAuditLog[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
}

model DocumentVersion {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  fileUrl    String
  fileName   String
  version    Int      @default(1)
  uploadedAt DateTime @default(now())
}

model DocumentAuditLog {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId     String
  action     String   // UPLOAD, DELETE, REPLACE, APPROVE, REJECT, DOWNLOAD, PREVIEW
  details    String?  @db.Text
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
}

model DocumentVerification {
  id         String   @id @default(uuid())
  documentId String   @unique
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  verifiedBy String?  // HR User Id or Name
  comment    String?
  verifiedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Policy {
  id           String             @id @default(uuid())
  title        String             @unique
  policyNumber String             @unique
  category     String             // ATTENDANCE, LEAVE, CODE_OF_CONDUCT, POSH, DATA_PRIVACY, INFO_SEC, IT_USAGE, NDA, HANDBOOK, etc.
  description  String?            @db.Text
  content      String             @db.Text // Rich Text editor content
  version      Int                @default(1)
  status       String             @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  effectiveDate DateTime?
  expiryDate   DateTime?
  createdBy    String?            // HR User ID or Name
  updatedBy    String?            // HR User ID or Name
  
  assignments  PolicyAssignment[]
  acceptances  PolicyAcceptance[]
  versions     PolicyVersion[]
  auditLogs    PolicyAuditLog[]

  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model PolicyVersion {
  id            String    @id @default(uuid())
  policyId      String
  policy        Policy    @relation(fields: [policyId], references: [id], onDelete: Cascade)
  title         String
  content       String    @db.Text
  versionNumber Int
  effectiveDate DateTime?
  createdAt     DateTime  @default(now())
}

model PolicyAssignment {
  id         String   @id @default(uuid())
  policyId   String
  policy     Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  targetType String   // ALL, DEPARTMENT, DESIGNATION, EMPLOYEE
  targetId   String?  // Dept ID, Desg ID, or Employee ID (null if ALL)
  createdAt  DateTime @default(now())
}

model PolicyAcceptance {
  id              String   @id @default(uuid())
  policyId        String
  policy          Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  versionAccepted Int      @default(1)
  acceptedAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([policyId, employeeId])
}

model Acknowledgement {
  id         String   @id @default(uuid())
  employeeId String   @unique
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  fullName   String
  ipAddress  String
  userAgent  String
  signedAt   DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model PolicyAuditLog {
  id         String   @id @default(uuid())
  policyId   String
  policy     Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  userId     String
  action     String   // CREATE, UPDATE, DELETE, PUBLISH, ARCHIVE, ASSIGN, ACCEPT
  details    String?  @db.Text
  createdAt  DateTime @default(now())
}

model Complaint {
  id              String                @id @default(uuid())
  complaintNumber String                @unique // E.g. COM-2026-0001
  title           String
  description     String                @db.Text
  category        String                // HR_ISSUE, SALARY_ISSUE, ATTENDANCE, LEAVE, MANAGER, IT_SUPPORT, PAYROLL, DOCUMENT_VERIFICATION, WORK_ENVIRONMENT, HARASSMENT, POSH, ASSET_ISSUE, SYSTEM_BUG, OTHER
  priority        String                // LOW, MEDIUM, HIGH, CRITICAL
  status          String                @default("OPEN") // OPEN, ASSIGNED, IN_PROGRESS, WAITING_FOR_EMPLOYEE, RESOLVED, CLOSED, REJECTED
  anonymous       Boolean               @default(false)
  
  raisedById      String
  raisedBy        Employee              @relation("EmployeeComplaintsRaised", fields: [raisedById], references: [id], onDelete: Cascade)
  
  assignedToId    String?               // Employee ID of Assigned HR
  assignedTo      Employee?             @relation("HRComplaintsAssigned", fields: [assignedToId], references: [id], onDelete: SetNull)
  
  replies         ComplaintReply[]
  attachments     ComplaintAttachment[]
  timeline        ComplaintTimeline[]
  auditLogs       ComplaintAuditLog[]
  assignments     ComplaintAssignment[]

  resolvedAt      DateTime?
  resolutionTime  Int?                  // in minutes
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
}

model ComplaintReply {
  id          String   @id @default(uuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  userId      String   // User ID
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message     String   @db.Text
  isInternal  Boolean  @default(false) // visible only to HR
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ComplaintAttachment {
  id          String   @id @default(uuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  fileUrl     String
  fileName    String
  fileType    String
  fileSize    Int
  createdAt   DateTime @default(now())
}

model ComplaintAssignment {
  id           String    @id @default(uuid())
  complaintId  String
  complaint    Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  assignedToId String
  assignedTo   Employee  @relation("HRComplaintsAssignmentHistory", fields: [assignedToId], references: [id], onDelete: Cascade)
  assignedById String
  assignedBy   Employee  @relation("HRComplaintsAssignedBy", fields: [assignedById], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
}

model ComplaintTimeline {
  id          String    @id @default(uuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  action      String    // COMPLAINT_CREATED, ASSIGNED, STATUS_CHANGED, PRIORITY_CHANGED, HR_REPLIED, EMPLOYEE_REPLIED, RESOLVED, CLOSED, REOPENED
  details     String    @db.Text
  actorId     String    // User ID
  actor       User      @relation(fields: [actorId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
}

model ComplaintAuditLog {
  id          String    @id @default(uuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  userId      String    // User ID
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  action      String    // E.g., VIEWED, CREATED, STATUS_UPDATE, FILE_DOWNLOAD
  details     String    @db.Text
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())
}


model Notification {
  id          String   @id @default(uuid())
  title       String
  description String   @db.Text
  type        String   // Trigger event name (e.g. AUTH_LOGIN, POLICY_ASSIGNED)
  module      String   // AUTH, EMPLOYEE, DOCUMENT, POLICY, COMPLAINT, SYSTEM
  priority    String   @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  icon        String?
  actionUrl   String?  // Link to open related page (Action Button)
  userId      String?  // Optional direct target user ID
  user        User?    @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  recipients  NotificationRecipient[]
  auditLogs   NotificationAuditLog[]
}

model NotificationRecipient {
  id             String       @id @default(uuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("UserNotificationRecipients", fields: [userId], references: [id], onDelete: Cascade)
  read           Boolean      @default(false)
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([notificationId, userId])
}

model Announcement {
  id          String   @id @default(uuid())
  title       String
  content     String   @db.Text
  category    String   // COMPANY_NEWS, HOLIDAY_NOTICE, MEETING_NOTICE, TRAINING_NOTICE, GENERAL_ANNOUNCEMENT
  createdById String
  createdBy   User     @relation("UserAnnouncementsCreated", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  recipients  AnnouncementRecipient[]
}

model AnnouncementRecipient {
  id             String       @id @default(uuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("UserAnnouncementRecipients", fields: [userId], references: [id], onDelete: Cascade)
  read           Boolean      @default(false)
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([announcementId, userId])
}

model NotificationPreference {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email         Boolean  @default(true)
  inApp         Boolean  @default(true)
  push          Boolean  @default(true)
  sound         Boolean  @default(true)
  doNotDisturb  Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model NotificationAuditLog {
  id             String        @id @default(uuid())
  notificationId String?
  notification   Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  userId         String
  action         String
  details        String?       @db.Text
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime      @default(now())
}

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String   // e.g. LOGIN, UPDATE_PROFILE, APPROVE_DOCUMENT, RAISE_COMPLAINT, etc.
  details    String   @db.Text
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// ATTENDANCE MANAGEMENT MODULE
// ==========================================

model Shift {
  id                    String              @id @default(uuid())
  name                  String              @unique // General Shift, Morning Shift, Evening Shift, Night Shift
  code                  String              @unique // GEN, MOR, EVE, NIGHT
  startTime             String              // HH:mm format e.g. "09:00"
  endTime               String              // HH:mm format e.g. "18:00"
  graceTime             Int                 @default(15) // in minutes
  lateMarkAfter         Int                 @default(15) // in minutes
  halfDayIfLateBy       Int                 @default(240) // in minutes (4 hours)
  minimumWorkingHours   Float               @default(8.0) // in hours
  maximumWorkingHours   Float               @default(12.0) // in hours
  breakTime             Int                 @default(60) // in minutes
  overtimeApplicable    Boolean             @default(false)
  flexibleShift         Boolean             @default(false)
  weekends              String              @default("SATURDAY,SUNDAY") // Comma-separated
  status                String              @default("ACTIVE") // ACTIVE, INACTIVE
  description           String?             @db.Text
  
  assignments           ShiftAssignment[]
  attendances           Attendance[]
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
}

model ShiftAssignment {
  id                    String              @id @default(uuid())
  employeeId            String
  employee              Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftId               String
  shift                 Shift               @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  effectiveFrom         DateTime
  effectiveTo           DateTime?
  isActive              Boolean             @default(true)
  assignedBy            String?             // HR User ID
  remarks               String?             @db.Text
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([employeeId, effectiveFrom])
}

model Attendance {
  id                    String              @id @default(uuid())
  employeeId            String
  employee              Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date                  DateTime            @db.Date
  shiftId               String?
  shift                 Shift?              @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  
  checkInTime           DateTime?
  checkOutTime          DateTime?
  workingHours          Float?              @default(0) // in hours
  breakTime             Int?                @default(0) // in minutes
  overtime              Float?              @default(0) // in hours
  
  status                String              // PRESENT, ABSENT, LATE, HALF_DAY, HOLIDAY, WEEK_OFF, LEAVE, WFH, ON_DUTY, MISSED_PUNCH
  lateBy                Int?                @default(0) // in minutes
  earlyExitBy           Int?                @default(0) // in minutes
  
  source                String              // MANUAL, WEB, MOBILE, BIOMETRIC, RFID, FACE_RECOGNITION, QR_CODE, GPS, API, WEBHOOK
  deviceType            String?             // Device identifier
  location              String?             @db.Text // JSON: {latitude, longitude, address}
  ipAddress             String?
  
  isManualEntry         Boolean             @default(false)
  approvedBy            String?             // HR User ID
  approvedAt            DateTime?
  remarks               String?             @db.Text
  
  logs                  AttendanceLog[]
  corrections           AttendanceCorrection[]
  history               AttendanceHistory[]
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([employeeId, date])
  @@index([employeeId, date])
  @@index([date])
  @@index([status])
}

model AttendanceLog {
  id                    String              @id @default(uuid())
  attendanceId          String?
  attendance            Attendance?         @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  employeeId            String
  date                  DateTime            @db.Date
  eventType             String              // CHECK_IN, CHECK_OUT, BREAK_START, BREAK_END
  timestamp             DateTime
  
  source                String              // MANUAL, WEB, MOBILE, BIOMETRIC, RFID, FACE_RECOGNITION, QR_CODE, GPS, API, WEBHOOK
  deviceId              String?
  deviceName            String?
  location              String?             @db.Text // JSON
  ipAddress             String?
  userAgent             String?
  
  rawData               String?             @db.Text // JSON of raw device data
  syncStatus            String              @default("SYNCED") // SYNCED, PENDING, FAILED
  
  createdAt             DateTime            @default(now())

  @@index([employeeId, date])
  @@index([timestamp])
}

model AttendanceCorrection {
  id                    String              @id @default(uuid())
  attendanceId          String
  attendance            Attendance          @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  employeeId            String
  
  field                 String              // CHECK_IN_TIME, CHECK_OUT_TIME, STATUS, WORKING_HOURS
  oldValue              String?
  newValue              String?
  reason                String              @db.Text
  
  status                String              @default("PENDING") // PENDING, APPROVED, REJECTED
  requestedBy           String              // Employee User ID
  requestedAt           DateTime            @default(now())
  
  approvedBy            String?             // HR User ID
  approvedAt            DateTime?
  rejectionReason       String?             @db.Text
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([attendanceId])
  @@index([status])
}

model AttendanceHistory {
  id                    String              @id @default(uuid())
  attendanceId          String
  attendance            Attendance          @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  
  field                 String
  oldValue              String?
  newValue              String?
  changedBy             String              // User ID
  changeReason          String?
  
  createdAt             DateTime            @default(now())

  @@index([attendanceId])
}

model AttendanceProvider {
  id                    String              @id @default(uuid())
  name                  String              @unique // MANUAL, BIOMETRIC, RFID, FACE_RECOGNITION, QR_CODE, GPS, API, WEBHOOK
  displayName           String
  type                  String              // MANUAL, DEVICE, SOFTWARE, API
  isActive              Boolean             @default(false)
  isPrimary             Boolean             @default(false)
  
  configuration         String?             @db.Text // JSON configuration
  description           String?             @db.Text
  
  devices               AttendanceDevice[]
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
}

model AttendanceDevice {
  id                    String              @id @default(uuid())
  providerId            String
  provider              AttendanceProvider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  
  name                  String
  deviceType            String              // BIOMETRIC, RFID_READER, FACE_SCANNER, QR_SCANNER, GPS_TRACKER
  model                 String?
  serialNumber          String?             @unique
  
  location              String?             // Office location
  departmentId          String?
  
  connectionType        String?             // TCP, HTTP, MQTT, WEBHOOK
  ipAddress             String?
  apiEndpoint           String?
  webhookUrl            String?
  
  status                String              @default("OFFLINE") // ONLINE, OFFLINE, MAINTENANCE, ERROR
  lastSyncAt            DateTime?
  lastHeartbeatAt       DateTime?
  
  configuration         String?             @db.Text // JSON device-specific config
  
  syncLogs              AttendanceSyncLog[]
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([providerId])
  @@index([status])
}

model AttendanceSyncLog {
  id                    String              @id @default(uuid())
  deviceId              String?
  device                AttendanceDevice?   @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  
  syncType              String              // AUTO, MANUAL, SCHEDULED, WEBHOOK
  syncStatus            String              // SUCCESS, FAILED, PARTIAL
  
  recordsProcessed      Int                 @default(0)
  recordsSuccess        Int                 @default(0)
  recordsFailed         Int                 @default(0)
  recordsDuplicate      Int                 @default(0)
  
  startTime             DateTime
  endTime               DateTime?
  duration              Int?                // in seconds
  
  errorDetails          String?             @db.Text
  syncData              String?             @db.Text // JSON summary
  
  createdAt             DateTime            @default(now())

  @@index([deviceId])
  @@index([syncStatus])
  @@index([startTime])
}

model Holiday {
  id                    String              @id @default(uuid())
  name                  String
  date                  DateTime            @db.Date
  type                  String              // NATIONAL, COMPANY, FESTIVAL, DEPARTMENT
  departmentId          String?
  description           String?             @db.Text
  isOptional            Boolean             @default(false)
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([name, date])
  @@index([date])
  @@index([type])
}

model WeekOff {
  id                    String              @id @default(uuid())
  employeeId            String?             // null means company-wide
  dayOfWeek             String              // SUNDAY, MONDAY, TUESDAY, etc.
  effectiveFrom         DateTime            @db.Date
  effectiveTo           DateTime?           @db.Date
  isActive              Boolean             @default(true)
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([employeeId])
  @@index([effectiveFrom])
}

model AttendanceSummary {
  id                    String              @id @default(uuid())
  employeeId            String
  month                 Int                 // 1-12
  year                  Int                 // 2026
  
  totalWorkingDays      Int                 @default(0)
  presentDays           Int                 @default(0)
  absentDays            Int                 @default(0)
  lateDays              Int                 @default(0)
  halfDays              Int                 @default(0)
  leaveDays             Int                 @default(0)
  holidayDays           Int                 @default(0)
  weekOffDays           Int                 @default(0)
  totalWorkingHours     Float               @default(0)
  overtimeHours         Float               @default(0)
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([employeeId, month, year])
  @@index([employeeId])
  @@index([year, month])
}

// ==========================================
// PAYROLL MANAGEMENT MODULE
// ==========================================

model SalaryStructure {
  id                    String              @id @default(uuid())
  employeeId            String
  employee              Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  // Basic Components
  basicSalary           Float               @default(0)
  hra                   Float               @default(0) // House Rent Allowance
  conveyance            Float               @default(0)
  medicalAllowance      Float               @default(0)
  specialAllowance      Float               @default(0)
  otherAllowances       Float               @default(0)
  
  // Deductions
  pf                    Float               @default(0) // Provident Fund
  esi                   Float               @default(0) // Employee State Insurance
  professionalTax       Float               @default(0)
  tds                   Float               @default(0) // Tax Deducted at Source
  otherDeductions       Float               @default(0)
  
  // Totals
  grossSalary           Float               @default(0)
  netSalary             Float               @default(0)
  ctc                   Float               @default(0) // Cost to Company
  
  effectiveFrom         DateTime
  effectiveTo           DateTime?
  isActive              Boolean             @default(true)
  
  remarks               String?             @db.Text
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([employeeId])
  @@index([effectiveFrom])
}

model PayrollRun {
  id                    String              @id @default(uuid())
  employeeId            String
  employee              Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  month                 Int                 // 1-12
  year                  Int                 // 2026
  paymentDate           DateTime?           @db.Date
  
  basicSalary           Float               @default(0)
  allowances            Float               @default(0)
  deductions            Float               @default(0)
  grossSalary           Float               @default(0)
  netSalary             Float               @default(0)
  
  status                String              @default("PENDING") // PENDING, PROCESSED, PAID, FAILED
  processedBy           String?             // HR User ID
  processedAt           DateTime?
  
  remarks               String?             @db.Text
  
  payslip               Payslip?
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([employeeId, month, year])
  @@index([employeeId])
  @@index([year, month])
  @@index([status])
}

model Payslip {
  id                    String              @id @default(uuid())
  payrollRunId          String              @unique
  payrollRun            PayrollRun          @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeId            String
  employee              Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  payslipNumber         String              @unique
  month                 Int
  year                  Int
  
  pdfUrl                String?
  sentToEmployee        Boolean             @default(false)
  sentAt                DateTime?
  downloadedAt          DateTime?
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([employeeId])
  @@index([year, month])
}

model Loan {
  id                    String              @id @default(uuid())
  employeeId            String
  employee              Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  loanType              String              // PERSONAL, EDUCATION, MEDICAL, EMERGENCY, HOME
  amount                Float
  interestRate          Float               @default(0)
  tenure                Int                 // in months
  emiAmount             Float
  
  approvedBy            String?             // HR User ID
  approvedAt            DateTime?
  
  status                String              @default("PENDING") // PENDING, APPROVED, REJECTED, DISBURSED, ACTIVE, CLOSED
  
  startDate             DateTime?
  endDate               DateTime?
  
  remarks               String?             @db.Text
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([employeeId])
  @@index([status])
}

model AdvanceSalary {
  id                    String              @id @default(uuid())
  employeeId            String
  employee              Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  amount                Float
  reason                String              @db.Text
  
  approvedBy            String?             // HR User ID
  approvedAt            DateTime?
  
  status                String              @default("PENDING") // PENDING, APPROVED, REJECTED, DISBURSED
  
  disbursedAt           DateTime?
  
  remarks               String?             @db.Text
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([employeeId])
  @@index([status])
}

// ==========================================
// PERFORMANCE MANAGEMENT MODULE - PHASE 14
// ==========================================

// Performance Cycle Management
model PerformanceCycle {
  id                    String              @id @default(uuid())
  name                  String              @unique // Q1 2026, H1 2026, Annual 2026, Custom Cycle Name
  type                  String              // QUARTERLY, HALF_YEARLY, ANNUAL, CUSTOM
  year                  Int
  quarter               Int?                // 1, 2, 3, 4 (for QUARTERLY)
  
  startDate             DateTime            @db.Date
  endDate               DateTime            @db.Date
  
  // Timeline
  selfAppraisalStartDate     DateTime?      @db.Date
  selfAppraisalEndDate       DateTime?      @db.Date
  managerReviewStartDate     DateTime?      @db.Date
  managerReviewEndDate       DateTime?      @db.Date
  hrReviewStartDate          DateTime?      @db.Date
  hrReviewEndDate            DateTime?      @db.Date
  
  status                String              @default("DRAFT") // DRAFT, ACTIVE, IN_PROGRESS, COMPLETED, CLOSED, ARCHIVED
  
  description           String?             @db.Text
  settings              String?             @db.Text // JSON: {enableSelfAppraisal, enable360Feedback, enableGoalWeightage, etc.}
  
  goals                 Goal[]
  kpis                  KPI[]
  kras                  KRA[]
  reviews               PerformanceReview[]
  
  createdBy             String?             // HR User ID
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([year, quarter])
  @@index([status])
  @@index([startDate, endDate])
}

// Goal Management
model Goal {
  id                    String              @id @default(uuid())
  cycleId               String
  cycle                 PerformanceCycle    @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  
  title                 String
  description           String              @db.Text
  
  type                  String              // INDIVIDUAL, TEAM, DEPARTMENT, COMPANY
  targetType            String              // EMPLOYEE, TEAM, DEPARTMENT // Employee ID, Team ID, Dept ID
  targetId              String?             
  
  category              String              // SALES, REVENUE, QUALITY, EFFICIENCY, LEARNING, INNOVATION, CUSTOMER_SATISFACTION, etc.
  priority              String              @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  
  // Measurement
  measurementType       String              // PERCENTAGE, NUMBER, BOOLEAN, QUALITATIVE
  targetValue           String?             // Target metric
  actualValue           String?             // Achieved metric
  unit                  String?             // %, numbers, currency, etc.
  
  weightage             Float               @default(0) // For weighted scoring
  progress              Float               @default(0) // 0-100
  completionPercentage  Float               @default(0)
  
  status                String              @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, COMPLETED, DELAYED, DROPPED
  
  // Ownership
  ownerId               String?             // Employee ID who owns this goal
  assignedBy            String?             // Manager/HR who assigned
  
  startDate             DateTime?           @db.Date
  dueDate               DateTime?           @db.Date
  completedDate         DateTime?           @db.Date
  
  // Supporting data
  milestones            String?             @db.Text // JSON array of milestones
  dependencies          String?             @db.Text // JSON array of dependent goal IDs
  attachments           String?             @db.Text // JSON array of file URLs
  
  remarks               String?             @db.Text
  
  updates               GoalUpdate[]
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([cycleId])
  @@index([targetType, targetId])
  @@index([ownerId])
  @@index([status])
}

model GoalUpdate {
  id                    String              @id @default(uuid())
  goalId                String
  goal                  Goal                @relation(fields: [goalId], references: [id], onDelete: Cascade)
  
  updateType            String              // PROGRESS_UPDATE, STATUS_CHANGE, MILESTONE_ACHIEVED, COMMENT
  progress              Float?              // Updated progress
  status                String?             // Updated status
  comment               String?             @db.Text
  
  updatedBy             String              // Employee/Manager User ID
  
  createdAt             DateTime            @default(now())

  @@index([goalId])
}

// KPI Management (Key Performance Indicators)
model KPI {
  id                    String              @id @default(uuid())
  cycleId               String
  cycle                 PerformanceCycle    @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  
  name                  String
  description           String?             @db.Text
  category              String              // SALES, REVENUE, PRODUCTIVITY, QUALITY, CUSTOMER_SERVICE, EFFICIENCY, etc.
  
  // Assignment
  assignedTo            String              // Employee ID
  assignedBy            String?             // Manager/HR User ID
  
  // Measurement
  measurementType       String              // NUMBER, PERCENTAGE, CURRENCY, BOOLEAN
  targetValue           Float
  actualValue           Float               @default(0)
  unit                  String?             // %, $, units, etc.
  
  weightage             Float               @default(0) // For weighted scoring
  completionPercentage  Float               @default(0)
  
  frequency             String              @default("MONTHLY") // DAILY, WEEKLY, MONTHLY, QUARTERLY, ANNUALLY
  
  // Thresholds for scoring
  excellentThreshold    Float?              // >= this is excellent (5)
  goodThreshold         Float?              // >= this is good (4)
  satisfactoryThreshold Float?              // >= this is satisfactory (3)
  
  status                String              @default("ACTIVE") // ACTIVE, COMPLETED, DROPPED
  
  remarks               String?             @db.Text
  
  readings              KPIReading[]
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([cycleId])
  @@index([assignedTo])
  @@index([category])
}

model KPIReading {
  id                    String              @id @default(uuid())
  kpiId                 String
  kpi                   KPI                 @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  
  readingDate           DateTime            @db.Date
  value                 Float
  remarks               String?             @db.Text
  
  recordedBy            String              // Employee/Manager User ID
  
  createdAt             DateTime            @default(now())

  @@index([kpiId])
  @@index([readingDate])
}

// KRA Management (Key Responsibility Areas)
model KRA {
  id                    String              @id @default(uuid())
  cycleId               String
  cycle                 PerformanceCycle    @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  
  title                 String
  description           String              @db.Text
  
  // Assignment
  assignedTo            String              // Employee ID
  assignedBy            String?             // Manager/HR User ID
  
  weightage             Float               @default(0) // For weighted scoring
  targetMetric          String?             // Expected outcome/deliverable
  
  // Manager Assessment
  managerRating         Int?                // 1-5
  managerComments       String?             @db.Text
  reviewedBy            String?             // Manager User ID
  reviewedAt            DateTime?
  
  status                String              @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, REVIEWED
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([cycleId])
  @@index([assignedTo])
  @@index([status])
}

// Performance Review (Main Appraisal Record)
model PerformanceReview {
  id                    String              @id @default(uuid())
  cycleId               String
  cycle                 PerformanceCycle    @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  
  employeeId            String              // Employee being reviewed
  
  // Review Status
  status                String              @default("NOT_STARTED") // NOT_STARTED, SELF_APPRAISAL_PENDING, SELF_APPRAISAL_SUBMITTED, MANAGER_REVIEW_PENDING, MANAGER_REVIEW_SUBMITTED, HR_REVIEW_PENDING, HR_REVIEW_COMPLETED, FINALIZED
  
  // Self Appraisal
  selfAppraisal         SelfAppraisal?
  
  // Manager Review
  managerReview         ManagerReview?
  
  // HR Review
  hrReview              HRReview?
  
  // Final Ratings
  finalRating           Int?                // 1-5 (from HR Review or calculated)
  normalizedScore       Float?              // 0-100
  
  // 360 Degree Feedback
  feedbacks             Feedback360[]
  
  // Recommendations
  promotionRecommendation    PromotionRecommendation?
  trainingRecommendations    TrainingRecommendation[]
  
  // Audit
  auditLogs             PerformanceAuditLog[]
  
  // Timeline
  selfAppraisalSubmittedAt   DateTime?
  managerReviewSubmittedAt   DateTime?
  hrReviewCompletedAt        DateTime?
  finalizedAt                DateTime?
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([cycleId, employeeId])
  @@index([cycleId])
  @@index([employeeId])
  @@index([status])
}

// Self Appraisal
model SelfAppraisal {
  id                    String              @id @default(uuid())
  reviewId              String              @unique
  review                PerformanceReview   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  
  // Achievements
  achievements          String              @db.Text // Major accomplishments
  challenges            String?             @db.Text // Challenges faced
  learnings             String?             @db.Text // What did you learn
  
  // Future Goals
  futureGoals           String?             @db.Text // Goals for next cycle
  trainingRequired      String?             @db.Text // Training needs
  careerAspirations     String?             @db.Text
  
  // Self Rating
  selfRating            Int?                // 1-5
  selfComments          String?             @db.Text
  
  // Goal & KPI Self Assessment
  goalAssessment        String?             @db.Text // JSON: [{goalId, selfRating, comments}]
  kpiAssessment         String?             @db.Text // JSON: [{kpiId, selfRating, comments}]
  kraAssessment         String?             @db.Text // JSON: [{kraId, selfRating, comments}]
  
  // Supporting Documents
  supportingDocuments   String?             @db.Text // JSON array of file URLs
  
  status                String              @default("DRAFT") // DRAFT, SUBMITTED
  submittedAt           DateTime?
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([reviewId])
}

// Manager Review
model ManagerReview {
  id                    String              @id @default(uuid())
  reviewId              String              @unique
  review                PerformanceReview   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  
  managerId             String              // Manager User ID
  
  // Manager Assessment
  overallComments       String              @db.Text
  strengths             String?             @db.Text
  areasOfImprovement    String?             @db.Text
  
  // Ratings
  managerRating         Int                 // 1-5
  
  // Goal & KPI Manager Assessment
  goalAssessment        String?             @db.Text // JSON: [{goalId, managerRating, comments, achieved}]
  kpiAssessment         String?             @db.Text // JSON: [{kpiId, managerRating, actualValue, comments}]
  kraAssessment         String?             @db.Text // JSON: [{kraId, managerRating, comments}]
  
  // Competency Assessment
  technicalSkills       Int?                // 1-5
  communication         Int?                // 1-5
  teamwork              Int?                // 1-5
  leadership            Int?                // 1-5
  problemSolving        Int?                // 1-5
  initiative            Int?                // 1-5
  adaptability          Int?                // 1-5
  timeManagement        Int?                // 1-5
  
  // Recommendations
  recommendPromotion    Boolean             @default(false)
  promotionReason       String?             @db.Text
  
  recommendIncrement    Boolean             @default(false)
  incrementPercentage   Float?
  incrementReason       String?             @db.Text
  
  recommendTraining     Boolean             @default(false)
  trainingAreas         String?             @db.Text
  
  // Manager Signature
  status                String              @default("DRAFT") // DRAFT, SUBMITTED
  submittedAt           DateTime?
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([reviewId])
  @@index([managerId])
}

// HR Review (Final Review)
model HRReview {
  id                    String              @id @default(uuid())
  reviewId              String              @unique
  review                PerformanceReview   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  
  hrId                  String              // HR User ID
  
  // HR Assessment
  hrComments            String?             @db.Text
  calibrationNotes      String?             @db.Text // Notes from calibration meeting
  
  // Final Rating
  finalRating           Int                 // 1-5
  ratingJustification   String?             @db.Text
  
  // Salary Recommendation
  currentSalary         Float?
  recommendedSalary     Float?
  incrementPercentage   Float?
  incrementEffectiveDate DateTime?          @db.Date
  salaryRemarks         String?             @db.Text
  
  // Promotion Recommendation
  currentDesignation    String?
  recommendedDesignation String?
  promotionEffectiveDate DateTime?          @db.Date
  promotionRemarks      String?             @db.Text
  
  // Performance Letter
  performanceLetterUrl  String?             // Generated PDF URL
  letterSentAt          DateTime?
  
  // HR Actions
  actionItems           String?             @db.Text // JSON array of action items
  followUpRequired      Boolean             @default(false)
  followUpDate          DateTime?           @db.Date
  
  status                String              @default("DRAFT") // DRAFT, COMPLETED
  completedAt           DateTime?
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([reviewId])
  @@index([hrId])
}

// Performance Rating Scale
model PerformanceRating {
  id                    String              @id @default(uuid())
  rating                Int                 @unique // 1, 2, 3, 4, 5
  label                 String              // Needs Improvement, Below Expectations, Meets Expectations, Exceeds Expectations, Outstanding
  description           String?             @db.Text
  minScore              Float               // Minimum normalized score for this rating
  maxScore              Float               // Maximum normalized score for this rating
  color                 String?             // UI color code
  
  isActive              Boolean             @default(true)
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
}

// 360 Degree Feedback
model Feedback360 {
  id                    String              @id @default(uuid())
  reviewId              String
  review                PerformanceReview   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  
  feedbackType          String              // MANAGER, PEER, SELF, HR, SUBORDINATE, CUSTOMER (future)
  feedbackFrom          String              // User ID of feedback provider
  feedbackFromName      String?             // Name (for anonymous feedback)
  
  isAnonymous           Boolean             @default(false)
  
  // Feedback Content
  strengths             String?             @db.Text
  weaknesses            String?             @db.Text
  suggestions           String?             @db.Text
  overallComments       String?             @db.Text
  
  // Ratings
  technicalSkills       Int?                // 1-5
  communication         Int?                // 1-5
  teamwork              Int?                // 1-5
  leadership            Int?                // 1-5
  problemSolving        Int?                // 1-5
  initiative            Int?                // 1-5
  
  overallRating         Int?                // 1-5
  
  status                String              @default("PENDING") // PENDING, SUBMITTED
  submittedAt           DateTime?
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([reviewId])
  @@index([feedbackType])
  @@index([feedbackFrom])
}

// Promotion Recommendation
model PromotionRecommendation {
  id                    String              @id @default(uuid())
  reviewId              String              @unique
  review                PerformanceReview   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  
  employeeId            String
  
  currentDesignation    String
  recommendedDesignation String
  
  justification         String              @db.Text
  
  recommendedBy         String              // Manager/HR User ID
  recommendedByRole     String              // MANAGER, HR
  
  approvalStatus        String              @default("PENDING") // PENDING, APPROVED, REJECTED, ON_HOLD
  approvedBy            String?             // HR/Super Admin User ID
  approvedAt            DateTime?
  rejectionReason       String?             @db.Text
  
  effectiveDate         DateTime?           @db.Date
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([reviewId])
  @@index([employeeId])
  @@index([approvalStatus])
}

// Training Recommendation
model TrainingRecommendation {
  id                    String              @id @default(uuid())
  reviewId              String
  review                PerformanceReview   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  
  employeeId            String
  
  trainingArea          String              // TECHNICAL, LEADERSHIP, COMMUNICATION, SOFT_SKILLS, DOMAIN_KNOWLEDGE, etc.
  trainingTitle         String
  description           String              @db.Text
  priority              String              @default("MEDIUM") // LOW, MEDIUM, HIGH
  
  recommendedBy         String              // Manager/HR User ID
  recommendedByRole     String              // MANAGER, HR, SELF
  
  status                String              @default("PENDING") // PENDING, APPROVED, SCHEDULED, COMPLETED, CANCELLED
  approvedBy            String?             // HR User ID
  approvedAt            DateTime?
  
  scheduledDate         DateTime?           @db.Date
  completedDate         DateTime?           @db.Date
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([reviewId])
  @@index([employeeId])
  @@index([status])
}

// Performance Audit Log
model PerformanceAuditLog {
  id                    String              @id @default(uuid())
  reviewId              String?
  review                PerformanceReview?  @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  
  entityType            String              // PERFORMANCE_REVIEW, GOAL, KPI, KRA, SELF_APPRAISAL, MANAGER_REVIEW, HR_REVIEW, FEEDBACK
  entityId              String
  
  action                String              // CREATED, UPDATED, DELETED, SUBMITTED, APPROVED, REJECTED, RATING_CHANGED, STATUS_CHANGED
  performedBy           String              // User ID
  performedByRole       String              // EMPLOYEE, MANAGER, HR, SUPER_ADMIN
  
  changes               String?             @db.Text // JSON of field changes
  remarks               String?             @db.Text
  
  ipAddress             String?
  userAgent             String?
  
  createdAt             DateTime            @default(now())

  @@index([reviewId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([performedBy])
}

// AI/ML Ready Interfaces

// Skill Gap Analysis (AI-Ready)
model SkillGapAnalysis {
  id                    String              @id @default(uuid())
  employeeId            String
  cycleId               String?
  
  currentSkills         String              @db.Text // JSON: [{skill, level, source}]
  requiredSkills        String              @db.Text // JSON: [{skill, level, importance}]
  skillGaps             String              @db.Text // JSON: [{skill, currentLevel, requiredLevel, priority}]
  
  analysisMethod        String              @default("MANUAL") // MANUAL, AI_GENERATED
  confidence            Float?              // AI confidence score 0-1
  
  recommendations       String?             @db.Text // JSON: Training recommendations
  
  analyzedBy            String?             // User ID or "AI_ENGINE"
  analyzedAt            DateTime            @default(now())
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([employeeId])
  @@index([cycleId])
}

// Attrition Prediction (AI-Ready)
model AttritionPrediction {
  id                    String              @id @default(uuid())
  employeeId            String
  
  riskScore             Float               // 0-1 (0=low risk, 1=high risk)
  riskLevel             String              // LOW, MEDIUM, HIGH, CRITICAL
  
  factors               String              @db.Text // JSON: [{factor, weight, contribution}]
  indicators            String?             @db.Text // JSON: List of risk indicators
  
