  error                 String?             @db.Text
  provider              String?             // SMTP, SENDGRID, RESEND, AWS_SES
  
  sentAt                DateTime?
  scheduledFor          DateTime?
  
  attachments           String?             @db.Text // JSON: [{filename, path, contentType}]
  
  metadata              String?             @db.Text // JSON: additional data
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([status])
  @@index([priority])
  @@index([scheduledFor])
}

// SMS Queue
model SMSQueue {
