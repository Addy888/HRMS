// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // HR, EMPLOYEE
  description String?
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id                 String           @id @default(uuid())
  email              String           @unique
  password           String
  roleId             String
  role               Role             @relation(fields: [roleId], references: [id])
  isFirstLogin       Boolean          @default(true)
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  employee           Employee?
  passwordResets     PasswordReset[]
  auditLogs          AuditLog[]
  notifications           Notification[]          @relation("UserNotifications")
  notificationRecipients  NotificationRecipient[] @relation("UserNotificationRecipients")
  announcementsCreated    Announcement[]          @relation("UserAnnouncementsCreated")
  announcementRecipients  AnnouncementRecipient[] @relation("UserAnnouncementRecipients")
  notificationPreference  NotificationPreference?
  complaintReplies   ComplaintReply[]
  complaintTimelineEvents ComplaintTimeline[]
  complaintAuditLogs ComplaintAuditLog[]
}

model Department {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  employees   Employee[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Designation {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  employees   Employee[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Employee {
  id            String             @id @default(uuid())
  employeeId    String             @unique // Custom format e.g. FCS-YYYY-XXXX
  userId        String             @unique
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName     String
  lastName      String
  phone         String?
  dob           DateTime?
  gender        String?
  bloodGroup    String?
  address       String? // Deprecated in favor of currentAddress/permanentAddress
  
  // Personal Info
  fatherName    String?
  motherName    String?
  maritalStatus String?
  nationality   String?

  // Contact Info
  alternatePhone String?
  personalEmail  String?
  permanentAddress String?
  currentAddress   String?
  emergencyContactName String?
  emergencyContactPhone String?
  emergencyContactRelation String?
  emergencyContact String? // Deprecated in favor of emergencyContactName/Phone/Relation

  // Professional Info
  reportingManager String?
  employmentType   String? // e.g. FULL_TIME, PART_TIME, CONTRACT, INTERN

  // Bank Details
  bankAccountHolder String?
  bankName          String?
  bankBranch        String?
  bankAccountNumber String?
  bankIfsc          String?
  upiId             String?

  // Government Details
  aadhaarNumber       String?
  panNumber           String?
  passportNumber      String?
  drivingLicenseNumber String?

  joiningDate   DateTime           @default(now())
  departmentId  String?
  department    Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designationId String?
  designation   Designation?       @relation(fields: [designationId], references: [id], onDelete: SetNull)
  photoUrl      String?
  onboardingStatus String          @default("PENDING") // PENDING, PROFILE_COMPLETED, DOCUMENTS_UPLOADED, POLICIES_ACCEPTED, COMPLETED, VERIFIED
  
  profile       EmployeeProfile?
  education     Education[]
  experience    Experience[]
  documents     Document[]
  acknowledgement Acknowledgement?
  acceptances   PolicyAcceptance[]
  complaintsRaised Complaint[] @relation("EmployeeComplaintsRaised")
  complaintsAssigned Complaint[] @relation("HRComplaintsAssigned")
  complaintAssignmentsHistory ComplaintAssignment[] @relation("HRComplaintsAssignmentHistory")
  complaintAssignmentsBy ComplaintAssignment[] @relation("HRComplaintsAssignedBy")

  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model EmployeeProfile {
  id                String   @id @default(uuid())
  employeeId        String   @unique
  employee          Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  profileCompletion Int      @default(0) // Percentage completion
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Education {
  id           String   @id @default(uuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  degree       String   // 10th, 12th, Graduation, PG, etc.
  institution  String
  passingYear  Int
  percentage   Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Experience {
  id           String    @id @default(uuid())
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  companyName  String
  designation  String
  startDate    DateTime
  endDate      DateTime?
  description  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model DocumentCategory {
  id        String     @id @default(uuid())
  name      String     @unique // PERSONAL, EDUCATIONAL, PROFESSIONAL, GOVERNMENT, OTHER
  documents Document[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Document {
  id           String                 @id @default(uuid())
  employeeId   String
  employee     Employee               @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type         String                 // RESUME, PHOTO, AADHAAR, PAN, PASSPORT, marksheet_10th, marksheet_12th, graduation_degree, etc.
  fileUrl      String
  fileName     String
  status       String                 @default("PENDING") // PENDING, APPROVED, REJECTED, RE_UPLOAD_REQUIRED
  categoryId   String?
  category     DocumentCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  verification DocumentVerification?
  versions     DocumentVersion[]
  auditLogs    DocumentAuditLog[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
}

model DocumentVersion {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  fileUrl    String
  fileName   String
  version    Int      @default(1)
  uploadedAt DateTime @default(now())
}

model DocumentAuditLog {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId     String
  action     String   // UPLOAD, DELETE, REPLACE, APPROVE, REJECT, DOWNLOAD, PREVIEW
  details    String?  @db.Text
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
}

model DocumentVerification {
  id         String   @id @default(uuid())
  documentId String   @unique
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  verifiedBy String?  // HR User Id or Name
  comment    String?
  verifiedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Policy {
  id           String             @id @default(uuid())
  title        String             @unique
  policyNumber String             @unique
  category     String             // ATTENDANCE, LEAVE, CODE_OF_CONDUCT, POSH, DATA_PRIVACY, INFO_SEC, IT_USAGE, NDA, HANDBOOK, etc.
  description  String?            @db.Text
  content      String             @db.Text // Rich Text editor content
  version      Int                @default(1)
  status       String             @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  effectiveDate DateTime?
  expiryDate   DateTime?
  createdBy    String?            // HR User ID or Name
  updatedBy    String?            // HR User ID or Name
  
  assignments  PolicyAssignment[]
  acceptances  PolicyAcceptance[]
  versions     PolicyVersion[]
  auditLogs    PolicyAuditLog[]

  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model PolicyVersion {
  id            String    @id @default(uuid())
  policyId      String
  policy        Policy    @relation(fields: [policyId], references: [id], onDelete: Cascade)
  title         String
  content       String    @db.Text
  versionNumber Int
  effectiveDate DateTime?
  createdAt     DateTime  @default(now())
}

model PolicyAssignment {
  id         String   @id @default(uuid())
  policyId   String
  policy     Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  targetType String   // ALL, DEPARTMENT, DESIGNATION, EMPLOYEE
  targetId   String?  // Dept ID, Desg ID, or Employee ID (null if ALL)
  createdAt  DateTime @default(now())
}

model PolicyAcceptance {
  id              String   @id @default(uuid())
  policyId        String
  policy          Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  versionAccepted Int      @default(1)
  acceptedAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([policyId, employeeId])
}

model Acknowledgement {
  id         String   @id @default(uuid())
  employeeId String   @unique
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  fullName   String
  ipAddress  String
  userAgent  String
  signedAt   DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model PolicyAuditLog {
  id         String   @id @default(uuid())
  policyId   String
  policy     Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  userId     String
  action     String   // CREATE, UPDATE, DELETE, PUBLISH, ARCHIVE, ASSIGN, ACCEPT
  details    String?  @db.Text
  createdAt  DateTime @default(now())
}

model Complaint {
  id              String                @id @default(uuid())
  complaintNumber String                @unique // E.g. COM-2026-0001
  title           String
  description     String                @db.Text
  category        String                // HR_ISSUE, SALARY_ISSUE, ATTENDANCE, LEAVE, MANAGER, IT_SUPPORT, PAYROLL, DOCUMENT_VERIFICATION, WORK_ENVIRONMENT, HARASSMENT, POSH, ASSET_ISSUE, SYSTEM_BUG, OTHER
  priority        String                // LOW, MEDIUM, HIGH, CRITICAL
  status          String                @default("OPEN") // OPEN, ASSIGNED, IN_PROGRESS, WAITING_FOR_EMPLOYEE, RESOLVED, CLOSED, REJECTED
  anonymous       Boolean               @default(false)
  
  raisedById      String
  raisedBy        Employee              @relation("EmployeeComplaintsRaised", fields: [raisedById], references: [id], onDelete: Cascade)
  
  assignedToId    String?               // Employee ID of Assigned HR
  assignedTo      Employee?             @relation("HRComplaintsAssigned", fields: [assignedToId], references: [id], onDelete: SetNull)
  
  replies         ComplaintReply[]
  attachments     ComplaintAttachment[]
  timeline        ComplaintTimeline[]
  auditLogs       ComplaintAuditLog[]
  assignments     ComplaintAssignment[]

  resolvedAt      DateTime?
  resolutionTime  Int?                  // in minutes
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
}

model ComplaintReply {
  id          String   @id @default(uuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  userId      String   // User ID
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message     String   @db.Text
  isInternal  Boolean  @default(false) // visible only to HR
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ComplaintAttachment {
  id          String   @id @default(uuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  fileUrl     String
  fileName    String
  fileType    String
  fileSize    Int
  createdAt   DateTime @default(now())
}

model ComplaintAssignment {
  id           String    @id @default(uuid())
  complaintId  String
  complaint    Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  assignedToId String
  assignedTo   Employee  @relation("HRComplaintsAssignmentHistory", fields: [assignedToId], references: [id], onDelete: Cascade)
  assignedById String
  assignedBy   Employee  @relation("HRComplaintsAssignedBy", fields: [assignedById], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
}

model ComplaintTimeline {
  id          String    @id @default(uuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  action      String    // COMPLAINT_CREATED, ASSIGNED, STATUS_CHANGED, PRIORITY_CHANGED, HR_REPLIED, EMPLOYEE_REPLIED, RESOLVED, CLOSED, REOPENED
  details     String    @db.Text
  actorId     String    // User ID
  actor       User      @relation(fields: [actorId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
}

model ComplaintAuditLog {
  id          String    @id @default(uuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  userId      String    // User ID
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  action      String    // E.g., VIEWED, CREATED, STATUS_UPDATE, FILE_DOWNLOAD
  details     String    @db.Text
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())
}


model Notification {
  id          String   @id @default(uuid())
  title       String
  description String   @db.Text
  type        String   // Trigger event name (e.g. AUTH_LOGIN, POLICY_ASSIGNED)
  module      String   // AUTH, EMPLOYEE, DOCUMENT, POLICY, COMPLAINT, SYSTEM
  priority    String   @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  icon        String?
  actionUrl   String?  // Link to open related page (Action Button)
  userId      String?  // Optional direct target user ID
  user        User?    @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  recipients  NotificationRecipient[]
  auditLogs   NotificationAuditLog[]
}

model NotificationRecipient {
  id             String       @id @default(uuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("UserNotificationRecipients", fields: [userId], references: [id], onDelete: Cascade)
  read           Boolean      @default(false)
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([notificationId, userId])
}

model Announcement {
  id          String   @id @default(uuid())
  title       String
  content     String   @db.Text
  category    String   // COMPANY_NEWS, HOLIDAY_NOTICE, MEETING_NOTICE, TRAINING_NOTICE, GENERAL_ANNOUNCEMENT
  createdById String
  createdBy   User     @relation("UserAnnouncementsCreated", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  recipients  AnnouncementRecipient[]
}

model AnnouncementRecipient {
  id             String       @id @default(uuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("UserAnnouncementRecipients", fields: [userId], references: [id], onDelete: Cascade)
  read           Boolean      @default(false)
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([announcementId, userId])
}

model NotificationPreference {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email         Boolean  @default(true)
  inApp         Boolean  @default(true)
  push          Boolean  @default(true)
  sound         Boolean  @default(true)
  doNotDisturb  Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model NotificationAuditLog {
  id             String        @id @default(uuid())
  notificationId String?
  notification   Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  userId         String
  action         String
  details        String?       @db.Text
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime      @default(now())
}

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String   // e.g. LOGIN, UPDATE_PROFILE, APPROVE_DOCUMENT, RAISE_COMPLAINT, etc.
  details    String   @db.Text
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
