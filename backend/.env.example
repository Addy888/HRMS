# Application
PORT=4000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000

# Database Connection (Replace with valid credentials)
DATABASE_URL="mysql://username:password@localhost:3306/fcs_hrms"

# JWT Auth Tokens
JWT_SECRET=replace-this-with-a-very-secure-jwt-key
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=replace-this-with-a-very-secure-refresh-key
JWT_REFRESH_EXPIRATION=7d

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# SMS/OTP Configuration
# SMS_PROVIDER options: console, twilio, aws-sns, fast2sms
SMS_PROVIDER=console
SMS_API_KEY=your-sms-provider-api-key-here
SMS_SENDER_ID=FCSHRM

# OTP Development Mode (NEVER use in production!)
# When set to true, OTP will be logged to console instead of sending SMS
OTP_DEV_MODE=true
