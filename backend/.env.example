# ═══════════════════════════════════════════════════════════════
# PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your production values
# NEVER commit .env to version control!
# ═══════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────
# DATABASE
# ───────────────────────────────────────────────────────────────
# Production MySQL database connection string
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://your_user:your_password@your_host:3306/hrms_production"

# ───────────────────────────────────────────────────────────────
# JWT AUTHENTICATION
# ───────────────────────────────────────────────────────────────
# Generate a secure random secret: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# ───────────────────────────────────────────────────────────────
# SERVER CONFIGURATION
# ───────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV="production"

# Frontend URL for CORS
FRONTEND_URL="https://your-frontend-domain.com"

# Backend URL (for email links, etc.)
BACKEND_URL="https://your-backend-domain.com"

# ───────────────────────────────────────────────────────────────
# CORS CONFIGURATION
# ───────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (CRITICAL: Set to your actual frontend domain in production)
CORS_ORIGIN="https://your-frontend-domain.com"
# For multiple domains: CORS_ORIGIN="https://domain1.com,https://domain2.com"

# ───────────────────────────────────────────────────────────────
# FILE STORAGE
# ───────────────────────────────────────────────────────────────
# Local storage path for uploads (ensure this directory is persistent)
UPLOAD_PATH="./uploads"

# Maximum file size (in bytes) - 10MB
MAX_FILE_SIZE=10485760

# ───────────────────────────────────────────────────────────────
# EMAIL CONFIGURATION (Optional - for notifications)
# ───────────────────────────────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-specific-password"
EMAIL_FROM="HRMS <noreply@yourcompany.com>"

# ───────────────────────────────────────────────────────────────
# OTP CONFIGURATION (Optional - for 2FA)
# ───────────────────────────────────────────────────────────────
OTP_SECRET="your-otp-secret-key"
OTP_EXPIRES_IN="300000"

# ───────────────────────────────────────────────────────────────
# LOGGING
# ───────────────────────────────────────────────────────────────
LOG_LEVEL="info"

# ───────────────────────────────────────────────────────────────
# SECURITY
# ───────────────────────────────────────────────────────────────
# Rate limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ───────────────────────────────────────────────────────────────
# PRODUCTION CHECKLIST
# ───────────────────────────────────────────────────────────────
# Before deploying, ensure:
# [x] JWT_SECRET is changed from default
# [x] DATABASE_URL points to production database
# [x] CORS_ORIGIN is set to your frontend domain (not "*")
# [x] All passwords and secrets are secure
# [x] .env is added to .gitignore
# [x] Email credentials are configured (if using email)
# [x] File storage path is persistent
# ═══════════════════════════════════════════════════════════════
